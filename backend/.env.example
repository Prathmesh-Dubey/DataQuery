GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-latest

GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ---------- Database backend ----------
# "supabase" or "sqlite"
DB_BACKEND=supabase

# ---------- SQLite (used when DB_BACKEND=sqlite) ----------
DATABASE_PATH=company.db

# ---------- Supabase PostgreSQL ----------
SUPABASE_DB_URL=postgresql://user:password@host:5432/postgres?sslmode=require

# ---------- JWT ----------
JWT_SECRET_KEY=generate-a-long-random-secret-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Query limits ----------
MAX_ROWS_RETURNED=500
QUERY_TIMEOUT_SECONDS=15

# ---------- Dev/testing ----------
# Enables POST /auth/fake — a no-credential login for local testing.
# NEVER set this to true in production.
ALLOW_FAKE_LOGIN=true

# ---------- Gmail SMTP (OTP) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_NAME=DataQuery Agent
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
